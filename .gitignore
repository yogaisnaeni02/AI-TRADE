# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Environment & local settings
.env
.env.*
venv/
.venv/
env/

# Logs & temp files
logs/*.log
logs/*.lock
*.log

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Runtime state risk manager (bukan konfigurasi)
logs/risk_state.json
logs/*.tmp

# Nama PC untuk label notifikasi Telegram - setelan PER-PC, bukan proyek.
# Kalau ikut di-commit, nama PC satu orang akan menimpa milik yang lain
# setiap kali pull, dan label di Telegram jadi salah.
logs/nama_pc.txt

# Backup data sebelum perbaikan offset waktu (lokal saja, jangan di-commit)
data_backup_pre_timefix/

# Dataset turunan yang bisa dibangun ulang (pipeline.build_dataset)
data/processed/XAUUSDm_M15_features.parquet

# artefak sementara CatBoost (dibuat scripts/ml_banding_algoritma.py)
catboost_info/

# Hasil GABUNGAN journal semua PC - file TURUNAN, dibangun ulang kapan
# saja dari logs/trades__<pc>.csv. Yang di-commit adalah file per-PC,
# bukan gabungannya; kalau gabungan ikut Git ia akan bentrok setiap kali
# dua PC menambah trade, persis masalah yang mau dihindari.
logs/trades_gabungan.csv
