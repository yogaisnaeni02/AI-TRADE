.idea/

# Runtime state risk manager (bukan konfigurasi)
logs/risk_state.json
logs/*.tmp

# Snapshot kondisi bot - DITULIS ULANG TIAP SIKLUS (3 detik).
#
# Dulu ikut Git dan itu salah: file yang berubah tiap detik membuat
# `git pull` GAGAL dengan "local changes would be overwritten" setiap kali
# bot sedang berjalan. Isinya pun tidak berguna bagi PC lain - hanya
# kondisi sesaat mesin yang menulisnya.
logs/snapshot.json

# Nama PC untuk label notifikasi Telegram - setelan PER-PC, bukan proyek.
# Kalau ikut di-commit, nama PC satu orang akan menimpa milik yang lain
# setiap kali pull, dan label di Telegram jadi salah.
logs/nama_pc.txt

# Backup data sebelum perbaikan offset waktu (lokal saja, jangan di-commit)
data_backup_pre_timefix/

# Dataset turunan yang bisa dibangun ulang (pipeline.build_dataset)
data/processed/XAUUSDm_M15_features.parquet

# artefak sementara CatBoost (dibuat scripts/ml_banding_algoritma.py)
catboost_info/

# Hasil GABUNGAN journal semua PC - file TURUNAN, dibangun ulang kapan
# saja dari logs/trades__<pc>.csv. Disimpan di docs/AnalisaLog untuk
# kebutuhan analisis lokal, bukan sebagai sumber data bot.
docs/AnalisaLog/trades_gabungan.csv
logs/trades_gabungan.csv

# Jaringan PC utama <-> worker (scripts/pc_worker, docs/51 bagian A).
# Semuanya setelan/data PER-PC utama, bukan proyek:
# - laporan/          kiriman Syncthing dari worker (journal, log, status)
# - pc_utama.json     lokasi Syncthing & folder rilis PC utama ini
# - PASANG-WORKER.bat berisi ID Syncthing PC utama ini
laporan/
pc_utama.json
PASANG-WORKER.bat

# Posisi terakhir perintah Telegram yang sudah diproses (per-PC).
logs/tg_kendali.json
